<Window x:Class="CarWashingSystem.Payment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarWashingSystem"
        mc:Ignorable="d"
        Title="Payment" Height="640" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Border Background="White" Margin="20" CornerRadius="8" Padding="30">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="CAR WASHING"
                       FontSize="30" FontWeight="Bold"
                       Foreground="#1B9AD2"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Hệ Thống Quản Lý Rửa Xe"
                       FontSize="14" Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,20"/>

            <!-- Title -->
            <TextBlock Text="THANH TOÁN"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#2C3E50"
                       Margin="0,0,0,15"/>

            <!-- Thông tin đặt lịch -->
            <Border Background="#F4F6F8" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Xe:" FontWeight="SemiBold" Margin="0,0,10,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtVehicle" Text="Toyota Vios - 51A-123.45" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ngày giờ:" FontWeight="SemiBold" Margin="0,0,10,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtDateTime" Text="22/07/2026 - 09:00" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gói dịch vụ:" FontWeight="SemiBold" Margin="0,0,10,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtService" Text="Rửa tiêu chuẩn" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Tổng tiền:" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtTotal" Text="50.000đ"
                               FontWeight="Bold" Foreground="#1B9AD2" FontSize="16"/>
                </Grid>
            </Border>

            <!-- Phương thức thanh toán -->
            <TextBlock Text="Chọn phương thức thanh toán:" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel Margin="0,0,0,20">
                <RadioButton x:Name="rdoCash" GroupName="Payment" IsChecked="True"
                             Content="Tiền mặt" Margin="0,0,0,8"/>
                <RadioButton x:Name="rdoMomo" GroupName="Payment"
                             Content="MoMo" Margin="0,0,0,8"/>
                <RadioButton x:Name="rdoCreditCard" GroupName="Payment"
                             Content="Thẻ tín dụng"/>
            </StackPanel>

            <!-- Buttons -->
            <Button x:Name="btnPay"
                    Content="Xác Nhận Thanh Toán"
                    Height="42" FontSize="15" FontWeight="Bold"
                    Foreground="White" Background="#1B9AD2"
                    BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="btnCancel"
                    Content="Hủy"
                    Height="38" FontSize="14"
                    Margin="0,10,0,0"
                    Foreground="#2C3E50" Background="#E9ECEF"
                    BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Border>
</Window>
