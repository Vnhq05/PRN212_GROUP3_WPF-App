<Window x:Class="CarWashingSystem.BookingPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarWashingSystem"
        mc:Ignorable="d"
        Title="Đặt lịch rửa xe" Height="640" Width="560"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <!-- KHAI BÁO STYLE NỘI BỘ CHO TRANG -->
    <Window.Resources>
        <!-- Style làm bo góc cho Nút bấm giống ảnh -->
        <Style TargetType="Button" x:Key="RoundedButtonStyle">
            <Setter Property="Background" Value="#0284C7"/>
            <!-- Mã màu bạn yêu cầu -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Chỉnh template để nút có góc bo tròn (CornerRadius) -->
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Hiệu ứng đổi màu nhẹ khi di chuột vào -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0269A4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- LƯỚI CĂN GIỮA MÀN HÌNH -->
    <Grid>
        <!-- KHỐI CARD TRẮNG BO GÓC (Giống hệt trang Login) -->
        <Border Background="White" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center"
                CornerRadius="12" Margin="20" Padding="30,40,30,40">

            <!-- Hiệu ứng đổ bóng mờ (Drop Shadow) -->
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>

            <StackPanel>

                <!-- Logo & Tiêu đề giống trang Login -->
                <TextBlock Text="CAR WASHING" FontSize="26" FontWeight="ExtraBold" Foreground="#0284C7" HorizontalAlignment="Center" />
                <TextBlock Text="Hệ Thống Quản Lý Rửa Xe" FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,5,0,30" />

                <TextBlock Text="ĐẶT LỊCH DỊCH VỤ" FontSize="18" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,20" />

                <!-- 1. Chọn xe -->
                <TextBlock Text="1. Chọn xe của bạn:" FontSize="13" Foreground="#4B5563" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <ComboBox Name="cmbCars" Height="38" Margin="0,0,0,15" Padding="5" VerticalContentAlignment="Center" BorderBrush="#D1D5DB" />

                <!-- 2. Ngày giờ -->
                <TextBlock Text="2. Chọn ngày và giờ:" FontSize="13" Foreground="#4B5563" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <!-- Khoảng cách giữa 2 ô -->
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <DatePicker Name="dpDate" Height="38" Grid.Column="0" Padding="5" VerticalContentAlignment="Center" BorderBrush="#D1D5DB"/>
                    <ComboBox Name="cmbTime" Height="38" Grid.Column="2" Padding="5" VerticalContentAlignment="Center" BorderBrush="#D1D5DB" />
                </Grid>

                <!-- 3. Gói dịch vụ -->
                <TextBlock Text="3. Chọn gói dịch vụ:" FontSize="13" Foreground="#4B5563" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <StackPanel Margin="0,0,0,15">
                    <RadioButton Name="rbBasic" GroupName="Service" Content="Rửa tiêu chuẩn (50.000đ)" FontSize="13" Foreground="#374151" Margin="0,0,0,8" />
                    <RadioButton Name="rbPremium" GroupName="Service" Content="Rửa cao cấp (100.000đ)" FontSize="13" Foreground="#374151" />
                </StackPanel>

                <!-- Khoảng cách trước nút xác nhận -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,25"/>

                <!-- Nút Xác nhận: Đã áp dụng Style bo góc và màu #0284C7 -->
                <Button Name="btnConfirm" Content="Xác Nhận Đặt Lịch" Height="42"
                        Click="btnConfirm_Click"
                        Style="{StaticResource RoundedButtonStyle}" />

            </StackPanel>
        </Border>
    </Grid>
</Window>