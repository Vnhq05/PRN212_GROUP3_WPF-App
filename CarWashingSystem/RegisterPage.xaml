<Window x:Class="CarWashingSystem.RegisterPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarWashingSystem"
        mc:Ignorable="d"
        Title="RegisterPage" Height="450" Width="800">
    <Grid>
        <!-- Khung Card Đăng ký -->
        <Border Width="420" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Center"
            Background="White" 
            CornerRadius="12" 
            Padding="30,25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#CBD5E1" Direction="270" ShadowDepth="4" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <!-- Tiêu đề -->
                <TextBlock Text="CAR WASH" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#0284C7" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,4"/>

                <TextBlock Text="TẠO TÀI KHOẢN MỚI" 
                       FontSize="18" 
                       FontWeight="SemiBold" 
                       Foreground="#1E293B" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

                <!-- Nhập Tên đăng nhập -->
                <TextBlock Text="Tên đăng nhập" Foreground="#475569" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="2">
                    <TextBox x:Name="txtUsername" Height="32" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Background="Transparent"/>
                </Border>

                <!-- Nhập Gmail -->
                <TextBlock Text="Gmail / Email" Foreground="#475569" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="2">
                    <TextBox x:Name="txtEmail" Height="32" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Background="Transparent"/>
                </Border>

                <!-- Nhập Số điện thoại -->
                <TextBlock Text="Số điện thoại" Foreground="#475569" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="2">
                    <TextBox x:Name="txtPhone" Height="32" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Background="Transparent"/>
                </Border>

                <!-- Nhập Mật khẩu -->
                <TextBlock Text="Mật khẩu" Foreground="#475569" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="2">
                    <PasswordBox x:Name="pwdPassword" Height="32" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Background="Transparent"/>
                </Border>

                <!-- Xác nhận Mật khẩu -->
                <TextBlock Text="Xác nhận mật khẩu" Foreground="#475569" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,15" Padding="2">
                    <PasswordBox x:Name="pwdConfirm" Height="32" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Background="Transparent"/>
                </Border>

                <!-- Dòng hiện lỗi -->
                <TextBlock x:Name="txtError" Text="" Foreground="Red" FontSize="12" TextWrapping="Wrap" Margin="0,-10,0,10"/>

                <!-- Nút Đăng ký -->
                <Button Content="Đăng Ký Tài Khoản" 
                    Click="BtnRegister_Click"
                    Height="38" 
                    Background="#0284C7" 
                    Foreground="White" 
                    FontSize="14" 
                    FontWeight="Bold" 
                    BorderThickness="0" 
                    Margin="0,5,0,12">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Quay lại Đăng nhập -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Đã có tài khoản? " Foreground="#64748B" FontSize="12"/>
                    <Button Content="Đăng nhập ngay" 
                        Click="BtnSwitchToLogin_Click"
                        Background="Transparent" 
                        Foreground="#0284C7" 
                        FontWeight="Bold" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
