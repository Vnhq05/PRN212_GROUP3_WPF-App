<Window x:Class="CarWashingSystem.HistoryStaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lịch Sử Làm Việc Nhân Viên" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="LỊCH SỬ LÀM VIỆC" FontSize="20" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,5"/>
                <TextBlock Text="Danh sách các công việc bạn đã hoàn thành." FontSize="14" Foreground="#6B7280"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="25">
            <StackPanel>
                <!-- Sửa giao diện DataGrid: Ẩn đường kẻ dọc, để nền trắng, đổi màu viền ngang và tăng RowHeight cho thoáng -->
                <DataGrid x:Name="dgHistoryJobs" MinHeight="350" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="45" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column">
                    <!-- Custom Header: Tăng chiều cao, in đậm, đổi màu nền xám nhạt để dễ nhìn -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="Padding" Value="10,0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <!-- Custom Cell: Bỏ viền gạch đứt (focus border) mặc định của WPF khi click vào ô -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Đặt Lịch" Binding="{Binding Id}" Width="90"/>
                        <DataGridTextColumn Header="Khách Hàng" Binding="{Binding Customer.FullName}" Width="160"/>
                        <DataGridTextColumn Header="Biển Số Xe" Binding="{Binding CustomerVehicle.LicensePlate}" Width="120"/>
                        <DataGridTextColumn Header="Khung Giờ" Binding="{Binding ScheduledStartTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                        <DataGridTextColumn Header="Giá(VNĐ)" Binding="{Binding TotalPrice, StringFormat='N0'}" Width="110"/>
                        <!-- Cột Trạng Thái (Badge): Dùng DataTemplate bọc TextBlock trong Border có bo góc -->
                        <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#DCFCE7">
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="12" Foreground="#16A34A" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Quay về trang Staff" Click="btnBack_Click" Width="160" Height="40" Background="#F1F5F9" Foreground="#334155" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
