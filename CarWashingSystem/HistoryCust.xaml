<Window x:Class="CarWashingSystem.HistoryCust"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarWashingSystem"
        mc:Ignorable="d"
        Title="Lịch Sử Dịch Vụ - Hệ Thống Rửa Xe" Height="768" Width="1366" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Thanh điều hướng -->
            <RowDefinition Height="*"/>
            <!-- Nội dung trang (giữ nguyên như cũ) -->
        </Grid.RowDefinitions>

        <!-- ===== TOPNAV ===== -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="CAR WASHING" FontSize="18" FontWeight="ExtraBold"
                           Foreground="#0284C7" VerticalAlignment="Center" Margin="20,0,25,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Đặt Lịch" Style="{StaticResource NavButton}" Click="navBooking_Click"/>
                    <Button Content="Hồ Sơ"   Style="{StaticResource NavButton}" Click="navProfile_Click"/>
                    <!-- Trang đang mở => style Active, không gắn Click -->
                    <Button Content="Lịch Sử" Style="{StaticResource NavButtonActive}"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Đăng Xuất" Margin="0,0,10,0"
                        Style="{StaticResource NavButtonLogout}" Click="navLogout_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="30">

            <!-- KHỐI CARD TRẮNG CHÍNH -->
            <Border Background="White" CornerRadius="12" Padding="30">
                <!-- Đổ bóng mờ -->
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58*"/>
                        <ColumnDefinition Width="27*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Chia làm 3 phần: Tiêu đề (0), Thống kê (1), và Bảng lịch sử (2) -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <!-- Dấu * để bảng tự giãn ra chiếm hết phần còn lại -->
                    </Grid.RowDefinitions>

                    <!-- PHẦN 0: TIÊU ĐỀ -->
                    <StackPanel Grid.Row="0" Margin="223,0,0,25" HorizontalAlignment="Left">
                        <TextBlock Text="CAR WASHING" FontSize="26" FontWeight="ExtraBold" Foreground="#0284C7" HorizontalAlignment="Center" />
                        <TextBlock Text="LỊCH SỬ &amp; ĐÁNH GIÁ DỊCH VỤ" FontSize="16" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>

                    <!-- PHẦN 1: THỐNG KÊ NHANH (SƯỜN: Để trống Text chờ C# nạp vào) -->
                    <Grid Grid.Row="1" Margin="0,0,0,25" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <!-- Khoảng cách giữa 2 cục -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tổng số lần rửa -->
                        <Border Grid.Column="0" Background="#F0F9FF" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Tổng số lần rửa xe" Foreground="#0284C7" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Name="txtTotalWashes" Text="..." FontSize="28" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tổng chi tiêu -->
                        <Border Grid.Column="2" Background="#F0F9FF" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Tổng tiền đã chi tiêu" Foreground="#0284C7" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Name="txtTotalSpent" Text="..." FontSize="28" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- PHẦN 2: BẢNG LỊCH SỬ (DataGrid) -->
                    <!-- Thiết lập AutoGenerateColumns="False" để tự định nghĩa các cột cho đẹp -->
                    <DataGrid Name="dgHistory" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                          Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                          RowHeight="45" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6" VerticalGridLinesBrush="Transparent" Grid.ColumnSpan="2">

                        <!-- Định dạng tiêu đề cột cho DataGrid -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <!-- Các cột khớp với bảng Bookings.
                             3 cột khóa ngoại đổi sang hiển thị thông tin của bảng liên kết
                             (Customer / AssignedStaff / CustomerVehicle) cho dễ đọc. -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding Customer.FullName}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding AssignedStaff.FullName}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Xe" Binding="{Binding CustomerVehicle.LicensePlate}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="BookingDate" Binding="{Binding BookingDate}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="ScheduledStartTime" Binding="{Binding ScheduledStartTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="ScheduledEndTime" Binding="{Binding ScheduledEndTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="CheckInTime" Binding="{Binding CheckInTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="CheckoutTime" Binding="{Binding CheckoutTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="TotalPrice" Binding="{Binding TotalPrice, StringFormat='{}{0:N0}'}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="CreatedAt" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="UpdatedAt" Binding="{Binding UpdatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" IsReadOnly="True" />

                            <!-- Cột Thao tác (Chứa nút bấm để Đánh giá hoặc Xem) -->
                            <DataGridTemplateColumn Header="Thao Tác" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Đánh Giá" Tag="{Binding Id}"
                                            Click="btnAction_Click"
                                            Background="#0284C7" Foreground="White" FontWeight="Bold"
                                            Width="90" Height="30" Cursor="Hand" BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
