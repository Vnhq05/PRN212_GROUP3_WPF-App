<Window x:Class="CarWashingSystem.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đánh Giá Khách Hàng - Hệ Thống Rửa Xe" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="ĐÁNH GIÁ TỪ KHÁCH HÀNG" FontSize="20" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,5"/>
                <TextBlock Text="Quản lý và xem phản hồi của khách hàng về dịch vụ bạn đã thực hiện." FontSize="14" Foreground="#6B7280"/>
            </StackPanel>
        </Border>

        <!-- Feedback List (DataGrid) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="20">
            <DataGrid MinHeight="300" AutoGenerateColumns="False" CanUserAddRows="False" Background="#FAFAFA" BorderBrush="#E5E7EB" RowHeight="35" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày" Width="100"/>
                    <DataGridTextColumn Header="Khách Hàng" Width="150"/>
                    <DataGridTextColumn Header="Mã Dịch Vụ" Width="100"/>
                    <DataGridTextColumn Header="Điểm (Sao)" Width="100"/>
                    <DataGridTextColumn Header="Bình Luận" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        
        <!-- Bottom Action -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,15,0,0">
            <Grid>
                <TextBlock Text="Cảm ơn bạn đã luôn cung cấp dịch vụ tốt nhất!" VerticalAlignment="Center" Foreground="#6B7280" FontStyle="Italic"/>
                <Button Content="Đóng Cửa Sổ" Width="120" Height="40" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand"/>
            </Grid>
        </Border>
        
    </Grid>
</Window>
