<Window x:Class="CarWashingSystem.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarWashingSystem"
        mc:Ignorable="d"
        Title="LoginPage" Height="450" Width="800">
    <Grid>
        <!-- Khung Card Đăng nhập nằm giữa màn hình -->
        <Border Width="380" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Center"
            Background="White" 
            CornerRadius="12" 
            Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#CBD5E1" Direction="270" ShadowDepth="4" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <!-- Logo & Tiêu đề -->
                <TextBlock Text="CAR WASHING" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#0284C7" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,5"/>

                <TextBlock Text="Hệ Thống Quản Lý Rửa Xe" 
                       FontSize="13" 
                       Foreground="#64748B" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,25"/>

                <TextBlock Text="ĐĂNG NHẬP" 
                       FontSize="18" 
                       FontWeight="SemiBold" 
                       Foreground="#1E293B" 
                       Margin="0,0,0,20"/>

                <!-- Ô nhập Tên đăng nhập / Số điện thoại -->
                <TextBlock Text="Tên đăng nhập / SĐT" Foreground="#475569" FontSize="12" FontWeight="Medium" Margin="0,0,0,5"/>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,15" Padding="2">
                    <TextBox Height="35" 
                         BorderThickness="0" 
                         VerticalContentAlignment="Center" 
                         Padding="8,0" 
                         FontSize="14" 
                         Background="Transparent"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <!-- Ô nhập Mật khẩu -->
                <TextBlock Text="Mật khẩu" Foreground="#475569" FontSize="12" FontWeight="Medium" Margin="0,0,0,5"/>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,20" Padding="2">
                    <PasswordBox Height="35" 
                             BorderThickness="0" 
                             VerticalContentAlignment="Center" 
                             Padding="8,0" 
                             FontSize="14" 
                             Background="Transparent"/>
                </Border>

                <!-- Nút Đăng nhập -->
                <Button Content="Đăng Nhập" 
                    Command="{Binding LoginCommand}"
                    Height="40" 
                    Background="#0284C7" 
                    Foreground="White" 
                    FontSize="14" 
                    FontWeight="Bold" 
                    BorderThickness="0" 
                    Margin="0,0,0,15">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Chuyển sang Đăng ký -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Chưa có tài khoản? " Foreground="#64748B" FontSize="12"/>
                    <Button Content="Đăng ký ngay" 
                        Command="{Binding SwitchToRegisterCommand}"
                        Background="Transparent" 
                        Foreground="#0284C7" 
                        FontWeight="Bold" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

</Window>
